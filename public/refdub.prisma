// --------------------------------------------------------
// CONFIGURATION
// --------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// 1. IDENTITY & ACCESS MANAGEMENT (IAM)
// Modeled after NextAuth.js adapters for easy integration
// --------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER)

  // Auth Relations
  accounts      Account[]
  sessions      Session[]

  // Platform Relations
  workspaces    WorkspaceMember[] // Workspaces they belong to (Brand side)
  submissions   Submission[]      // Campaigns they joined (Creator side)
  affiliateLinks AffiliateLink[]
  
  // Financials
  wallet        Wallet?           // Each user has one wallet
  payoutMethods PayoutMethod[]    // Linked Bank Accounts (Razorpay Fund Accounts)

  @@index([email])
}

// Stores OAuth Tokens (Instagram, YouTube) strictly for official API usage.
// We encrypt these tokens at the application level before saving.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String  // "instagram", "youtube", "google"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------------------------
// 2. MULTI-TENANCY (WORKSPACES)
// Brands work in "Workspaces" so teams can manage campaigns together.
// --------------------------------------------------------

enum WorkspaceRole {
  OWNER
  MEMBER
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // For URL: app.platform.com/brand-slug
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     WorkspaceMember[]
  campaigns   Campaign[]
  wallet      Wallet?  // The Brand's funding wallet

  // Stripe/Razorpay Customer ID for billing the brand
  billingId   String?  
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// --------------------------------------------------------
// 3. CAMPAIGN ENGINE (The Core Logic)
// --------------------------------------------------------

enum CampaignType {
  PR_VIRAL   // Fork 1: Views/Virality
  AFFILIATE  // Fork 2: Sales/Leads
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  slug        String         @unique
  description String?        @db.Text
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  
  // Rules & Logic
  totalBudget Decimal        @default(0.00) @db.Decimal(10, 2)
  remainingBudget Decimal    @default(0.00) @db.Decimal(10, 2)
  
  // Platform Constraints
  acceptedPlatforms String[] // ["INSTAGRAM", "YOUTUBE"]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets      CampaignAsset[]
  
  // Specific Rules (One-to-One)
  prRule      PRCampaignRule?
  affRule     AffiliateCampaignRule?

  submissions Submission[]
  affiliateLinks AffiliateLink[]

  @@index([workspaceId])
  @@index([status])
}

model CampaignAsset {
  id          String   @id @default(cuid())
  campaignId  String
  url         String   // S3 / Cloudflare R2 URL
  type        String   // "VIDEO", "IMAGE", "AUDIO"
  name        String
  
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Fork 1 Logic: The "Base + Bonus" Rules
model PRCampaignRule {
  id              String   @id @default(cuid())
  campaignId      String   @unique
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  basePayAmount   Decimal  @default(0.00) @db.Decimal(10, 2)
  targetViews     Int      @default(10000)
  bonusPayAmount  Decimal  @default(0.00) @db.Decimal(10, 2)
  
  // Advanced: Tiered Bonuses (JSON for flexibility)
  // e.g. { "100k": 5000, "1M": 50000 }
  tiers           Json?    
}

// Fork 2 Logic: The Affiliate Rules
model AffiliateCampaignRule {
  id              String   @id @default(cuid())
  campaignId      String   @unique
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  commissionType  String   // "PERCENTAGE" | "FIXED"
  commissionValue Decimal  @db.Decimal(10, 2)
  cookieWindow    Int      @default(30) // Days
}

// --------------------------------------------------------
// 4. SUBMISSION ENGINE (Fork 1 Execution)
// --------------------------------------------------------

enum SubmissionStatus {
  PENDING_REVIEW // Waiting for admin/AI
  APPROVED       // Base Pay Released
  REJECTED       // No Pay
  TARGET_HIT     // Bonus Pay Released
  TARGET_MISSED  // Campaign Ended
}

model Submission {
  id             String           @id @default(cuid())
  campaignId     String
  userId         String           // The Creator
  
  // Content
  platform       String           // "INSTAGRAM"
  externalId     String?          // The Instagram Media ID (for API lookups)
  liveUrl        String           @unique
  
  // Metrics (Synced via API)
  initialViews   Int              @default(0)
  currentViews   Int              @default(0)
  lastSyncedAt   DateTime?
  
  // State
  status         SubmissionStatus @default(PENDING_REVIEW)
  rejectionReason String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  campaign       Campaign         @relation(fields: [campaignId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  payouts        Payout[]         // Links to the money sent
  
  // Audit Trail of Status Changes
  activityLogs   SubmissionActivity[]

  @@index([campaignId])
  @@index([userId])
}

// Logs state changes for disputes (e.g., "Why was I rejected?")
model SubmissionActivity {
  id           String   @id @default(cuid())
  submissionId String
  action       String   // "APPROVED", "SYNC_VIEWS"
  metadata     Json?    // { "views": 15000, "adminId": "..." }
  createdAt    DateTime @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// 5. AFFILIATE ENGINE (Fork 2 Execution)
// --------------------------------------------------------

model AffiliateLink {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  slug        String   @unique // e.g. "brand.com/ref/USER123"
  clicks      Int      @default(0)
  sales       Int      @default(0)
  
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  events      AffiliateEvent[]

  @@unique([campaignId, userId])
}

model AffiliateEvent {
  id              String   @id @default(cuid())
  affiliateLinkId String
  type            String   // "CLICK", "LEAD", "SALE"
  metadata        Json?    // { "orderValue": 500, "currency": "INR" }
  createdAt       DateTime @default(now())
  
  link            AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// 6. FINANCIAL LEDGER (Razorpay Route)
// Double-entry bookkeeping style for audit safety
// --------------------------------------------------------

model Wallet {
  id          String   @id @default(cuid())
  currency    String   @default("INR")
  balance     Decimal  @default(0.00) @db.Decimal(15, 2)
  
  // Owner (Polymorphic-ish relationship)
  userId      String?  @unique // If Creator
  workspaceId String?  @unique // If Brand
  
  user        User?      @relation(fields: [userId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  
  transactions Transaction[]
}

// Stores the "Contact" and "Fund Account" IDs from Razorpay
model PayoutMethod {
  id            String  @id @default(cuid())
  userId        String
  type          String  // "UPI", "BANK_ACCOUNT"
  contactId     String  // Razorpay Contact ID (cont_...)
  fundAccountId String  // Razorpay Fund Account ID (fa_...)
  isDefault     Boolean @default(false)

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PayoutType {
  BASE_PAY
  PERFORMANCE_BONUS
  AFFILIATE_COMMISSION
}

enum PayoutStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model Payout {
  id             String       @id @default(cuid())
  submissionId   String?
  affiliateLinkId String?
  amount         Decimal      @db.Decimal(10, 2)
  type           PayoutType
  status         PayoutStatus @default(PROCESSING)
  
  // Razorpay specific
  payoutId       String?      @unique // Razorpay Payout ID (pout_...)
  fundAccountId  String       // Where it was sent
  
  // Idempotency Key (Crucial to prevent double payments)
  idempotencyKey String       @unique 
  
  createdAt      DateTime     @default(now())
  processedAt    DateTime?

  submission     Submission?  @relation(fields: [submissionId], references: [id])
}

// The Immutable Ledger
model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  amount      Decimal  @db.Decimal(15, 2) // Positive for credit, Negative for debit
  description String
  referenceId String?  // ID of Submission, Payout, or Deposit
  createdAt   DateTime @default(now())
  
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

// --------------------------------------------------------
// 7. SYSTEM & AUDIT
// --------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   // Who did it?
  event       String   // "CAMPAIGN_CREATED", "PAYOUT_TRIGGERED"
  resourceId  String   // ID of object affected
  ipAddress   String?
  userAgent   String?
  metadata    Json?    // Before/After values
  createdAt   DateTime @default(now())

  @@index([resourceId])
}
